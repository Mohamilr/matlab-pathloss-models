% Load data
data = readtable('100MHz_10m_VV.csv');
d_km = data.Distance_To_Server_1_km;
PL_measured = data.Path_Loss_dB;  % Ensure this is the correct column name!
valid = d_km > 0;
d_km = d_km(valid);
PL_measured = PL_measured(valid);
d_m = d_km * 1000;

% Constants
f = 24000;             % MHz
hb = 10;
hr = 1.5;
d0 = 1;                % Reference distance (1 m)

% Terrain A parameters
a = 4.6;
b = 0.0075;
c1 = 12.6;

% Calculate gamma
gamma = a - b * hb + c1 / hb;
gamma_vec = repmat(gamma, size(d_m));

% Free-space path loss at d0
lambda = 3e8 / (f * 1e6);
A = 20 * log10((4 * pi * d0) / lambda);
A_vec = repmat(A, size(d_m));

% Frequency and height correction
X_f = 6 * log10(f / 2000);
X_h = -10.8 * log10(hr / 2);
X_f_vec = repmat(X_f, size(d_m));
X_h_vec = repmat(X_h, size(d_m));

% Compute predicted PL without shadowing
PL_no_shadow = A_vec + 10 * gamma_vec .* log10(d_m / d0) + X_f_vec + X_h_vec;

% Compute shadow fading from measurement
X = PL_measured - PL_no_shadow;

% Compute alpha for each point using:
% alpha = X - (0.65 * log10(f)^2 - 1.3 * log10(f))
logf = log10(f);
alpha_i = X - (0.65 * logf^2 - 1.3 * logf);
alpha = mean(alpha_i);  % final estimated alpha from empirical data

% Now compute S using calculated alpha
S_vec = 0.65 * logf^2 - 1.3 * logf + alpha;

% Final SUI path loss with calculated shadow fading
PL_sui = PL_no_shadow + S_vec;

% Construct output table
T = table(d_km, A_vec, gamma_vec, X_f_vec, X_h_vec, S_vec, PL_sui, ...
    'VariableNames', {'Distance_km', 'A', 'Gamma', 'X_f', 'X_h', 'S', 'PL_SUI'});

% Append mean row
mean_row = T(1,:);
mean_row{:,:} = [mean(d_km); A; gamma; X_f; X_h; mean(S_vec); mean(PL_sui)];
T = [T; mean_row];
T.Properties.RowNames = [cellstr(string(1:height(T)-1)); {'Mean'}];

% Display estimated alpha and table
disp(['Estimated alpha (mean): ', num2str(alpha)]);
disp(T);

writetable(T, 'SUI_Urban_Output.xlsx', 'WriteRowNames', true);





3GPP TR 38.901 (UMa NLOS)
% Load Excel data
data = readtable('100MHz_10m_VV.csv');
d_km = data.Distance_To_Server_1_km;
valid = d_km > 0;
d_km = d_km(valid);
d_m = d_km * 1000;

% Parameters
f_GHz = 24;       % Frequency in GHz
h_BS = 10;        % Base station height (TX), meters
h_UT = 1.5;       % User terminal (RX) height

% LOS model (used inside max)
PL_LOS = 28 + 22*log10(d_m) + 20*log10(f_GHz);
PL_LOS_vec = PL_LOS;

% NLOS model
PL_NLOS = 13.54 + 39.08 * log10(d_m) + 20 * log10(f_GHz) - 0.6 * (h_BS - 1.5);
PL_NLOS_vec = PL_NLOS;

% Final UMa NLOS path loss: take max(LOS, NLOS)
PL_final = max(PL_LOS_vec, PL_NLOS_vec);

% Create output table
T = table(d_km, d_m, PL_LOS_vec, PL_NLOS_vec, PL_final, ...
    'VariableNames', {'Distance_km', 'Distance_m', 'PL_LOS', 'PL_NLOS', 'PL_UMa_NLOS'});

% Compute and append mean row
mean_row = T(1, :);
mean_row{:,:} = [mean(d_km); mean(d_m); mean(PL_LOS_vec); mean(PL_NLOS_vec); mean(PL_final)];
T = [T; mean_row];
T.Properties.RowNames = [cellstr(string(1:height(T)-1)); {'Mean'}];

% Display result
disp(T);

% Optional: export
writetable(T, '3GPP_UMa_NLOS_Output.xlsx', 'WriteRowNames', true);



